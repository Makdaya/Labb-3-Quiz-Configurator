<Window x:Class="Labb_3_Quiz_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labb_3_Quiz_Configurator"
        xmlns:views="clr-namespace:Labb_3_Quiz_Configurator.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:MenuView Grid.Row="0"/>
        
        
        <views:ConfigurationView Grid.Row="1">
            <views:ConfigurationView.Style>
                <Style TargetType="views:ConfigurationView">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsPlayMode,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:ConfigurationView.Style>
        </views:ConfigurationView>

        <views:PlayerView Grid.Row="1"
                  DataContext="{Binding PlayerViewModel}">
            <views:PlayerView.Style>
                <Style TargetType="views:PlayerView">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsPlayMode,
                    RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:PlayerView.Style>
        </views:PlayerView>

    </Grid>
</Window>
