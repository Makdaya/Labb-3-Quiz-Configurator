<UserControl x:Class="Labb_3_Quiz_Configurator.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb_3_Quiz_Configurator.Views"
             DataContext="{Binding ConfigurationViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">

                <TextBlock Text="Default Question Pack"
                           Margin="10,10,100,10"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <Button Content="⚙️" Margin="5"/>
                <Button Content="+" Margin="5"/>
                <Button Content="-" Margin="5"/>

            </StackPanel>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding ActivePack.Questions}"
                     SelectedItem="{Binding SelectedQuestion}">
                

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Query}"
                                   Margin="5"/>
                    </DataTemplate>
                    
                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>
        <StackPanel Grid.Column="1" Margin="20">

            <TextBlock Text="Question:"
               FontWeight="Bold"
               Margin="0,0,0,5"/>

            <TextBox Height="70"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Text="{Binding SelectedQuestion.Query, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Correct Answer:"
                       FontWeight="Bold"
                       Margin="0 10 0 5"/>

            <TextBox Height="25"
                     Text="{Binding SelectedQuestion.CorrectAnswer, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="First Incorrect Answer:"
                       FontWeight="Bold"
                       Margin="0 10 0 5"/>

            <TextBox Height="25"
                    Text="{Binding SelectedQuestion.IncorrectAnswers[0], UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Second Incorrect Answer:"
                       FontWeight="Bold"
                       Margin="0 10 0 5"/>

            <TextBox Height="25"
                     Text="{Binding SelectedQuestion.IncorrectAnswers[1], UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Third Incorrect Answer:"
                       FontWeight="Bold"
                       Margin="0 10 0 5"/>

            <TextBox Height="25"
                     Text="{Binding SelectedQuestion.IncorrectAnswers[2], UpdateSourceTrigger=PropertyChanged}"/>


        </StackPanel>
    </Grid>

</UserControl>
